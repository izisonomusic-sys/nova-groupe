# Exemple de configuration Nginx pour servir uniquement le frontend TTE Energy.
# Adapter server_name et le chemin root avant activation.
server {
    listen 80;
    listen [::]:80;
    server_name VOTRE_DOMAINE;

    root /var/www/tte-energy;
    index index.html;

    server_tokens off;
    charset utf-8;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    # Les pages HTML et le service worker doivent pouvoir être actualisés rapidement.
    location ~* \.html$ {
        try_files $uri =404;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location = /service-worker.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
    }

    # Les fichiers statiques sont servis directement par Oracle/Nginx.
    location /assets/ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    # Fichiers racine (manifest, icônes, etc.) : pas de fallback vers le backend.
    location / {
        try_files $uri $uri/ =404;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json application/manifest+json image/svg+xml;
}
