# Supabase — serveur uniquement (NE JAMAIS mettre la service_role dans le navigateur)
SUPABASE_URL=https://yidtsgqvnwksdbovovax.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# PayDunya — PRODUCTION / LIVE
# Les trois secrets doivent provenir de la MEME application PayDunya en mode production.
PAYDUNYA_MODE=live
PAYDUNYA_MASTER_KEY=YOUR_PAYDUNYA_MASTER_KEY
PAYDUNYA_LIVE_PRIVATE_KEY=YOUR_PAYDUNYA_LIVE_PRIVATE_KEY
PAYDUNYA_LIVE_TOKEN=YOUR_PAYDUNYA_LIVE_TOKEN
# Alias accepte aussi : PAYDUNYA_PRIVATE_KEY et PAYDUNYA_TOKEN
PAYDUNYA_STORE_NAME=NOVA Immobilier & Energies

# En production, configurez le retour vers l’espace membre (le prestataire peut ajouter le token de facture).
# Exemple : https://VOTRE-SITE.onrender.com/app.html?payment_return=1#/historique
# Utilisez uniquement des URLs publiques HTTPS pour le retour et le callback.
PAYDUNYA_RETURN_URL=
PAYDUNYA_CANCEL_URL=
PAYDUNYA_CALLBACK_URL=
PORT=3000
